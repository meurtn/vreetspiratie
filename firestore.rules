rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Een huishouden is alleen bereikbaar als je de koppelcode (het document-id) kent.
    // Lijsten opvragen van alle huishoudens kan niet, dus codes zijn niet te raden of op te sommen.
    match /huishoudens/{code} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null && code.matches('^[A-Z0-9]{12}$');
      allow list, delete: if false;

      match /gerechten/{id} {
        allow read, write: if request.auth != null && code.matches('^[A-Z0-9]{12}$');
      }
      match /fotos/{id} {
        allow get, write: if request.auth != null && code.matches('^[A-Z0-9]{12}$');
        allow list: if false;
      }
    }
  }
}
