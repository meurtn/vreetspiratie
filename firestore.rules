rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Alleen deze Google-accounts mogen de lijst lezen en wijzigen.
    // Vervang de twee adressen in Firebase Console door jullie eigen adressen, in kleine letters.
    // Laat de echte adressen niet in de openbare repo staan.
    function magErin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['VUL_EMAIL_1', 'VUL_EMAIL_2'];
    }

    match /huishoudens/thuis {
      allow read, write: if magErin();
      match /{document=**} {
        allow read, write: if magErin();
      }
    }
  }
}
